# Brickken sandbox API
BRICKKEN_API_BASE_URL=https://api.sandbox.brickken.com
BRICKKEN_API_KEY=

# The wallet this project builds with. Must be whitelisted by Brickken
# (request this in the same message as your API key). This wallet signs
# issuer-side actions: newTokenization, whitelist, mintToken, newSto,
# closeOffer, dividendDistribution.
# Fund it with Sepolia test ETH from a faucet before using it.
BRICKKEN_SIGNER_ADDRESS=
BRICKKEN_SIGNER_PRIVATE_KEY=

# A separate demo wallet acting as the investor for this sandbox build.
# newInvest and claimTokens are signed by the investor, not the issuer.
# This wallet must also be whitelisted (done automatically by the
# /onboard flow) and funded with Sepolia test ETH for gas, plus sandbox
# test USDT once minted.
BRICKKEN_INVESTOR_ADDRESS=
BRICKKEN_INVESTOR_PRIVATE_KEY=

# A private value only you know. Protects every write route (tokenize,
# create-sto, whitelist, invest, claim) from being triggered by strangers
# once this app is deployed publicly. Pick any long random string.
RWAOS_OPERATOR_TOKEN=

# Sepolia, hex chain id as required by Brickken sandbox
BRICKKEN_CHAIN_ID=aa36a7

# App
NEXT_PUBLIC_APP_NAME=RWAOS
NEXT_PUBLIC_NETWORK=sandbox
